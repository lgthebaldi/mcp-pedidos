{"momento": "2026-11-14T22:27:59", "ferramenta": "consultar", "argumentos": {"sql": "WITH dias AS (SELECT date(data_hora) AS dia, CASE WHEN strftime('%w', data_hora) IN ('0','6') THEN 'fim de semana' ELSE 'dia útil' END AS tipo, COUNT(*) AS pedidos, SUM(CASE WHEN status='entregue' THEN valor_total ELSE 0 END) AS fat, SUM(status='entregue') AS entregues FROM pedidos GROUP BY dia) SELECT tipo, COUNT(*) AS dias, SUM(pedidos) AS pedidos, ROUND(1.0*SUM(pedidos)/COUNT(*),1) AS pedidos_por_dia, ROUND(SUM(fat)/COUNT(*),2) AS faturamento_por_dia, ROUND(SUM(fat)/SUM(entregues),2) AS ticket_medio FROM dias GROUP BY tipo"}, "duracao_ms": 10, "resultado": {"colunas": ["tipo", "dias", "pedidos", "pedidos_por_dia", "faturamento_por_dia", "ticket_medio"], "linhas": [["dia útil", 65, 3106, 47.8, 3468.24, 77.18], ["fim de semana", 27, 1894, 70.1, 5171.9, 77.45]], "truncado": false, "linhas_devolvidas": 2}}
